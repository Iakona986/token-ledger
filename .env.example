# SQLite database file for the events + models tables
TOKEN_LEDGER_DB=token_ledger.db

# Server bind
TOKEN_LEDGER_HOST=127.0.0.1
TOKEN_LEDGER_PORT=8000

# Shared secret LiteLLM sends as an Authorization header. When set, requests without a
# matching Bearer token are rejected (401). When unset, /webhook returns 503 (fail closed):
# anonymous writes are never accepted, even accidentally.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=

# Local dev only: set to 1 to accept requests without a secret. NEVER set in production.
TOKEN_LEDGER_ALLOW_UNAUTHENTICATED_DEV=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
